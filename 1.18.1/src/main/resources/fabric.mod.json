{
  "schemaVersion": 1,
  "id": "shadowlink",
  "version": "${version}",
  "name": "ShadowLink",
  "description": "Detects vanilla Item Shadowing and restores the shared ItemStack reference after logout, chunk reload and server restart.",
  "authors": ["AtsukiMC"],
  "icon": "assets/shadowlink/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.atsukimc.shadowlink.ShadowLink"]
  },
  "mixins": ["shadowlink.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=17"
  }
}
